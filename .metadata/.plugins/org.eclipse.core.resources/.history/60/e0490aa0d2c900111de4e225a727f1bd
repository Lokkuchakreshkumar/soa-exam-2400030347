package com.klef.soa.exam.controller;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import com.klef.soa.exam.entity.FoodTruckEntity;
import com.klef.soa.exam.service.FoodTruckService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;

@RestController
@CrossOrigin(origins = "*")
@Tag(name = "FoodTruck Controller", description = "Endpoints for FoodTruck CRUD operations")
public class FoodTruckController {

    @Autowired
    private FoodTruckService foodTruckService;

  
    @GetMapping(value = {"/", ""})
    public ResponseEntity<String> checkRunning() {
        return ResponseEntity.ok("CRUD Service is running");
    }

   
    @PostMapping(value = {"/Add", "/add"})
    public ResponseEntity<FoodTruckEntity> addFoodTruck(@RequestBody FoodTruckEntity foodTruck) {
        foodTruck.setId(null);
        FoodTruckEntity saved = foodTruckService.addFoodTruck(foodTruck);
        return new ResponseEntity<>(saved, HttpStatus.CREATED);
    }

   
    @GetMapping(value = {"/DisplayAll", "/displayAll", "/displayall"})
    public ResponseEntity<List<FoodTruckEntity>> displayAll() {
        List<FoodTruckEntity> list = foodTruckService.getAllFoodTrucks();
        return ResponseEntity.ok(list);
    }

  
    @DeleteMapping(value = {"/Delete/{id}", "/delete/{id}"})
    public ResponseEntity<String> deleteFoodTruck(@PathVariable("id") Long id) {
        boolean deleted = foodTruckService.deleteFoodTruck(id);
        if (deleted) {
            return ResponseEntity.ok("FoodTruck with ID " + id + " deleted successfully");
        } else {
            return ResponseEntity.status(HttpStatus.NOT_FOUND)
                    .body("FoodTruck with ID " + id + " does not exist");
        }
    }
}
